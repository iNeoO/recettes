# Environnement de production pour docker-compose.prod.yaml. Copier en
# `.env.docker`. Compose le lit deux fois : pour interpoler les ${...} du
# fichier compose, et comme env_file des conteneurs — les hôtes sont donc des
# noms de conteneurs.

# --- Postgres (ce stack) ----------------------------------------------------
POSTGRES_DB=recettes
POSTGRES_USER=recettes
POSTGRES_PASSWORD=
PG_HOST_PORT=5435
DATABASE_URL=postgres://recettes:CHANGE_ME@postgres:5432/recettes

# --- Garage (stack infra, partagé) -------------------------------------------
# Le stack rejoint `garage-network` et parle à garage-prod par son nom. Il faut
# une clé et un bucket à lui :
#   docker exec garage-prod /garage key create recettes-prod
#   docker exec garage-prod /garage bucket create recettes-prod
#   docker exec garage-prod /garage bucket allow --read --write recettes-prod --key <key id>
S3_ENDPOINT=http://garage-prod:3900
S3_REGION=garage
S3_BUCKET=recettes-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# À renseigner seulement si les réseaux partagés portent un autre nom sur l'hôte.
# GARAGE_NETWORK=garage-network
# MONITORING_SHARED_NETWORK=monitoring-shared

# --- Web ----------------------------------------------------------------------
# Publié sur loopback, pour le reverse proxy de la machine. Le cookie de session
# est `Secure` : il faut du HTTPS devant.
WEB_HOST_PORT=3030

# --- Ingestion (make prod-ingest) --------------------------------------------
# Dossier de l'hôte qui contient list1.pdf et list2.pdf.
PDF_DIR=/srv/recettes/pdf
