# Copier en .env puis remplir. Aucun secret n'est versionné.
#   openssl rand -hex 32   → GARAGE_RPC_SECRET et GARAGE_ADMIN_TOKEN
#   openssl rand -hex 16   → S3_SECRET_ACCESS_KEY

POSTGRES_USER=recettes
POSTGRES_PASSWORD=
POSTGRES_DB=recettes
POSTGRES_PORT=5433
DATABASE_URL=postgres://recettes:CHANGEME@localhost:5433/recettes
# Base dédiée aux tests, créée et migrée automatiquement.
TEST_DATABASE_URL=postgres://recettes:CHANGEME@localhost:5433/recettes_test

GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_S3_PORT=3900
GARAGE_ADMIN_PORT=3903

S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=recettes
S3_ACCESS_KEY_ID=GK...  # GK + 24 hexa
S3_SECRET_ACCESS_KEY=       # openssl rand -hex 32

API_PORT=3000
