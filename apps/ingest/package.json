{
  "name": "@recettes/ingest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ingest": "node --env-file=../../.env --import tsx src/ingest.ts",
    "export-lines": "node --import tsx scripts/export-lines.ts",
    "check-catalog": "node --import tsx scripts/check-catalog.ts",
    "verify": "node --env-file=../../.env --import tsx scripts/verify-ingredients.ts",
    "quality": "node --env-file=../../.env --import tsx scripts/quality.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "suggest-aliases": "node --import tsx scripts/suggest-aliases.ts",
    "suggest-units": "node --import tsx scripts/suggest-units.ts",
    "check-units": "node --import tsx scripts/check-units.ts"
  },
  "dependencies": {
    "@recettes/db": "workspace:*",
    "@aws-sdk/client-s3": "^3.734.0",
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "^0.108.2",
    "effect": "catalog:",
    "unpdf": "^1.8.1",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
