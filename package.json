{
  "name": "recettes",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "migrate": "pnpm --filter @recettes/db migrate",
    "ingest": "pnpm --filter @recettes/ingest ingest",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1"
  }
}
